+// Admin → Analytics. The numbers from PostHog, inside the admin, so nobody has to log in to PostHog to check
+// how the site is doing. Read-only; the data comes from server-functions/posthog-admin.ts.
+import { useCallback, useEffect, useRef, useState } from "react";
+import { getPostHogSnapshot } from "@/server-functions/posthog-admin";
+import type { Days, PostHogNotConfigured, PostHogSnapshot } from "@/lib/posthog-admin-core";
+
+type AdminUser = { getIdToken: () => Promise<string> };
+type Result = PostHogSnapshot | PostHogNotConfigured;
+
+const n = (x: number) => x.toLocaleString("en-IN");
+const rupees = (x: number) => `₹${Math.round(x).toLocaleString("en-IN")}`;
+const short = (day: string) => new Date(`${day}T12:00:00Z`).toLocaleDateString("en-IN", { day: "numeric", month: "short", timeZone: "UTC" });
+const pct = (a: number, b: number) => (b > 0 ? `${Math.round((a / b) * 100)}%` : "–");
+
+function Kpi({ label, value, sub, bad }: { label: string; value: string; sub?: string; bad?: boolean }) {
+  return (
+    <div className="clay px-5 py-4">
+      <p className="text-[11px] font-bold uppercase tracking-wide text-foreground/45">{label}</p>
+      <p className="mt-1 font-display text-3xl font-bold leading-tight text-foreground">{value}</p>
+      {sub && <p className={`mt-0.5 text-xs ${bad ? "text-red-600" : "text-foreground/50"}`}>{sub}</p>}
+    </div>
+  );
+}
+
+function Card({ title, hint, failed, children }: { title: string; hint?: string; failed?: string; children: React.ReactNode }) {
+  return (
+    <div className="clay p-5">
+      <div className="mb-4">
+        <h3 className="font-display text-sm font-bold text-foreground">{title}</h3>
+        {hint && <p className="text-xs text-foreground/45">{hint}</p>}
+      </div>
+      {failed ? <p className="text-sm text-red-600">Couldn't load this: {failed}</p> : children}
+    </div>
+  );
+}
+
+function Rows({ rows }: { rows: { label: string; n: number }[] }) {
+  const max = Math.max(1, ...rows.map((r) => r.n));
+  if (rows.length === 0) return <p className="text-sm text-foreground/45">No data yet.</p>;
+  return (
+    <ul className="space-y-2.5">
+      {rows.map((r) => (
+        <li key={r.label}>
+          <div className="flex items-center justify-between gap-2 text-xs">
+            <span className="truncate text-foreground">{r.label}</span>
+            <span className="font-semibold tabular-nums text-foreground">{n(r.n)}</span>
+          </div>
+          <div className="mt-1 h-2 overflow-hidden rounded-full bg-secondary">
+            <div className="h-full rounded-full bg-primary" style={{ width: `${Math.max(3, (r.n / max) * 100)}%` }} />
+          </div>
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+// Each funnel is "how many people did this step in the period". It is not a strict ordered funnel: someone who
+// only did step 2 still counts there. Good for spotting where people fall away, not for exact conversion rates.
+const FUNNELS: { title: string; steps: { event: string; label: string }[] }[] = [
+  { title: "Practice", steps: [{ event: "login_completed", label: "Signed in or signed up" }, { event: "drill_started", label: "Started a drill" }, { event: "drill_submitted", label: "Finished a drill" }] },
+  { title: "Mentor sessions", steps: [{ event: "session_viewed", label: "Viewed a session" }, { event: "session_booking_started", label: "Started booking" }, { event: "session_booked", label: "Booked" }] },
+  { title: "Edurack Pro", steps: [{ event: "pro_checkout_started", label: "Opened checkout" }, { event: "pro_purchased", label: "Bought Pro" }] },
+];
+
+function SetupHelp({ missing }: { missing: string[] }) {
+  return (
+    <div className="clay p-6">
+      <h3 className="font-display text-lg font-bold text-foreground">Connect PostHog to see your numbers here</h3>
+      <p className="mt-1 text-sm text-foreground/60">One-time setup, about five minutes. Still missing: <b>{missing.join(", ")}</b>.</p>
+      <ol className="mt-4 list-decimal space-y-2 pl-5 text-sm text-foreground/80">
+        <li>In PostHog open your profile (bottom left) → <b>Personal API keys</b> → <b>Create personal API key</b>. Give it the <b>Query: Read</b> scope only, and limit it to your project. Copy the key (it starts with <code>phx_</code>).</li>
+        <li>In PostHog → <b>Settings → Project</b>, copy the numeric <b>Project ID</b>.</li>
+        <li>In Vercel → your project → <b>Settings → Environment Variables</b>, add <code>POSTHOG_PERSONAL_API_KEY</code> and <code>POSTHOG_PROJECT_ID</code>. Also add <code>POSTHOG_APP_HOST</code> as <code>https://us.posthog.com</code> or <code>https://eu.posthog.com</code>, whichever you use.</li>
+        <li>Redeploy, then reopen this tab.</li>
+      </ol>
+      <p className="mt-4 rounded-xl bg-secondary px-4 py-3 text-xs text-foreground/70">
+        Keep the key secret: never put it in a variable that starts with <code>VITE_</code> (those are visible to every visitor) and never commit it. It is only ever used on the server.
+      </p>
+    </div>
+  );
+}
+
+function EmbeddedDashboard({ url }: { url: string }) {
+  const ref = useRef<HTMLIFrameElement>(null);
+  const [height, setHeight] = useState(900);
+  useEffect(() => {
+    const onMessage = (e: MessageEvent) => {
+      if (e.source !== ref.current?.contentWindow) return;
+      const d = e.data as { event?: string; height?: number } | null;
+      if (d?.event === "posthog:dimensions" && typeof d.height === "number" && d.height > 200) setHeight(Math.min(d.height, 4000));
+    };
+    window.addEventListener("message", onMessage);
+    return () => window.removeEventListener("message", onMessage);
+  }, []);
+  return (
+    <div className="clay overflow-hidden p-2">
+      <iframe ref={ref} src={url} title="PostHog dashboard" width="100%" height={height} className="block rounded-xl border-0" loading="lazy" />
+    </div>
+  );
+}
+
+export function ProductAnalyticsView({
+  result,
+  days,
+  onDays,
+  onRefresh,
+  busy,
+  error,
+}: {
+  result: Result | null;
+  days: Days;
+  onDays: (d: Days) => void;
+  onRefresh: () => void;
+  busy: boolean;
+  error: string | null;
+}) {
+  if (error) {
+    return (
+      <div className="clay p-6">
+        <p className="text-sm text-red-600">{error}</p>
+        <button type="button" onClick={onRefresh} className="mt-3 rounded-full border border-border px-4 py-2 text-sm font-semibold">Try again</button>
+      </div>
+    );
+  }
+  if (!result) return <div className="clay p-6 text-sm text-foreground/50">Loading analytics…</div>;
+  if (!result.configured) return <SetupHelp missing={result.missing} />;
+
+  const s = result;
+  const failed = (card: string) => s.failures.find((f) => f.card === card)?.message;
+  const ev = (name: string) => s.events?.[name];
+  const bookings = ev("session_booked");
+  const pro = ev("pro_purchased");
+  const updated = new Date(s.fetchedAt).toLocaleTimeString("en-IN", { hour: "numeric", minute: "2-digit", timeZone: "Asia/Kolkata" });
+  const maxDaily = Math.max(1, ...(s.daily ?? []).map((d) => d.visitors));
+
+  return (
+    <div className="space-y-5">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div>
+          <h2 className="font-display text-xl font-bold text-foreground">Analytics</h2>
+          <p className="text-xs text-foreground/50">Last {s.days} days · from PostHog · updated {updated} IST (refreshes every 10 minutes)</p>
+        </div>
+        <div className="flex items-center gap-2">
+          {([7, 30] as Days[]).map((d) => (
+            <button key={d} type="button" onClick={() => onDays(d)} aria-pressed={days === d} className={`rounded-full border px-4 py-1.5 text-sm font-semibold ${days === d ? "border-foreground bg-foreground text-background" : "border-border"}`}>
+              {d} days
+            </button>
+          ))}
+          <button type="button" onClick={onRefresh} disabled={busy} className="rounded-full border border-border px-4 py-1.5 text-sm font-semibold disabled:opacity-50">{busy ? "Loading…" : "Refresh"}</button>
+          <a href={s.appUrl} target="_blank" rel="noopener noreferrer" className="rounded-full border border-border px-4 py-1.5 text-sm font-semibold">Open PostHog ↗</a>
+        </div>
+      </div>
+
+      {s.failures.length > 0 && <p className="rounded-xl bg-amber-50 px-4 py-2 text-xs text-amber-900">Some cards couldn't load, see the red notes below. The rest is fine.</p>}
+
+      <div className="grid grid-cols-2 gap-3 lg:grid-cols-6">
+        <Kpi label="Visitors" value={s.totals ? n(s.totals.visitors) : "–"} sub={failed("totals")} bad={!!failed("totals")} />
+        <Kpi label="Pageviews" value={s.totals ? n(s.totals.pageviews) : "–"} />
+        <Kpi label="Drills started" value={ev("drill_started") ? n(ev("drill_started")!.total) : "–"} sub={ev("drill_started") ? `${n(ev("drill_started")!.people)} people` : undefined} />
+        <Kpi label="Sessions booked" value={bookings ? n(bookings.total) : "–"} sub={bookings && bookings.value > 0 ? `${rupees(bookings.value)} booking value` : undefined} />
+        <Kpi label="Pro purchases" value={pro ? n(pro.total) : "–"} sub={pro && pro.value > 0 ? rupees(pro.value) : undefined} />
+        <Kpi label="Errors" value={s.errors === null ? "–" : n(s.errors)} sub={s.errors ? "Open PostHog → Error tracking" : undefined} bad={!!s.errors} />
+      </div>
+
+      <Card title="Visitors per day" failed={failed("daily")}>
+        <div className="flex h-32 items-end gap-[3px]">
+          {(s.daily ?? []).map((d) => (
+            <div key={d.day} title={`${short(d.day)}: ${d.visitors} visitors, ${d.pageviews} pageviews`} className="flex h-full flex-1 flex-col justify-end">
+              <div className="w-full rounded-t-md bg-primary" style={{ height: `${Math.max(d.visitors ? 4 : 1.5, (d.visitors / maxDaily) * 100)}%`, opacity: d.visitors ? 1 : 0.25 }} />
+            </div>
+          ))}
+        </div>
+        <div className="mt-1.5 flex justify-between text-[10px] text-foreground/40">
+          <span>{s.daily?.[0] ? short(s.daily[0].day) : ""}</span>
+          <span>{s.daily?.length ? short(s.daily[s.daily.length - 1].day) : ""}</span>
+        </div>
+      </Card>
+
+      <div className="grid gap-4 lg:grid-cols-3">
+        {FUNNELS.map((f) => {
+          const first = ev(f.steps[0].event)?.people ?? 0;
+          return (
+            <Card key={f.title} title={f.title} hint="People who did each step. Not a strict order." failed={failed("events")}>
+              <ul className="space-y-3">
+                {f.steps.map((st, i) => {
+                  const people = ev(st.event)?.people ?? 0;
+                  return (
+                    <li key={st.event}>
+                      <div className="flex items-center justify-between gap-2 text-xs">
+                        <span className="text-foreground">{st.label}</span>
+                        <span className="font-semibold tabular-nums text-foreground">{n(people)}{i > 0 && <span className="ml-1 font-normal text-foreground/45">({pct(people, first)})</span>}</span>
+                      </div>
+                      <div className="mt-1 h-2 overflow-hidden rounded-full bg-secondary">
+                        <div className="h-full rounded-full bg-primary" style={{ width: `${first > 0 ? Math.max(people ? 3 : 0, (people / first) * 100) : 0}%` }} />
+                      </div>
+                    </li>
+                  );
+                })}
+              </ul>
+            </Card>
+          );
+        })}
+      </div>
+
+      <div className="grid gap-4 lg:grid-cols-3">
+        <Card title="Top pages" hint="Pageviews" failed={failed("pages")}>
+          <Rows rows={(s.topPages ?? []).map((p) => ({ label: p.path, n: p.views }))} />
+        </Card>
+        <Card title="Where visitors come from" hint="Visitors, by referring site" failed={failed("sources")}>
+          <Rows rows={(s.sources ?? []).map((p) => ({ label: p.source, n: p.visitors }))} />
+        </Card>
+        <Card title="Devices" hint="Visitors" failed={failed("devices")}>
+          <Rows rows={(s.devices ?? []).map((p) => ({ label: p.device, n: p.visitors }))} />
+        </Card>
+      </div>
+
+      {s.embedUrl && (
+        <div>
+          <h3 className="mb-2 font-display text-sm font-bold text-foreground">Your PostHog dashboard</h3>
+          <EmbeddedDashboard url={s.embedUrl} />
+        </div>
+      )}
+    </div>
+  );
+}
+
+export function ProductAnalyticsModule({ adminUser }: { adminUser: AdminUser }) {
+  const [result, setResult] = useState<Result | null>(null);
+  const [days, setDays] = useState<Days>(7);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const load = useCallback(
+    async (force: boolean) => {
+      setBusy(true);
+      setError(null);
+      try {
+        setResult(await getPostHogSnapshot({ data: { token: await adminUser.getIdToken(), days, force } }));
+      } catch (e) {
+        setError((e as Error).message || "Couldn't load analytics.");
+      }
+      setBusy(false);
+    },
+    [adminUser, days],
+  );
+  useEffect(() => {
+    void load(false);
+  }, [load]);
+
+  return <ProductAnalyticsView result={result} days={days} onDays={setDays} onRefresh={() => void load(true)} busy={busy} error={error} />;
+}
diff --git a/src/lib/posthog-admin-core.ts b/src/lib/posthog-admin-core.ts
new file mode 100644
index 0000000..987549e
--- /dev/null
+++ b/src/lib/posthog-admin-core.ts
@@ -0,0 +1,174 @@
+// Reads Edurack's own numbers back out of PostHog for the admin "Analytics" tab, so nobody has to log in to
+// PostHog just to look at them. Pure logic (config, queries, shaping), so it can be tested without a server.
+//
+// Only aggregate counts leave PostHog: no person records, no emails, no replays.
+// The personal API key stays on the server; the browser only ever receives the shaped numbers.
+
+export type Days = 7 | 30;
+export const clampDays = (d: unknown): Days => (d === 30 ? 30 : 7);
+
+export type HogEnv = Partial<Record<"POSTHOG_PERSONAL_API_KEY" | "POSTHOG_PROJECT_ID" | "POSTHOG_APP_HOST" | "POSTHOG_EMBED_URL" | "VITE_PUBLIC_POSTHOG_HOST", string | undefined>>;
+export type HogConfig = { key: string; projectId: string; appHost: string; embedUrl: string | null };
+
+/** The events this app sends (see lib/analytics.ts callers). Order doesn't matter. */
+export const TRACKED_EVENTS = [
+  "login_completed",
+  "drill_started",
+  "drill_submitted",
+  "test_submitted",
+  "session_viewed",
+  "session_booking_started",
+  "session_booked",
+  "session_booking_failed",
+  "pro_checkout_started",
+  "pro_purchased",
+] as const;
+
+/**
+ * Sending events and reading them back use different hosts: the browser posts to us.i.posthog.com, while the API
+ * lives on us.posthog.com. Derive one from the other for the standard cloud hosts; a custom proxy or a
+ * self-hosted PostHog has to say where its API is.
+ */
+function deriveAppHost(env: HogEnv): { host: string } | { missing: string } {
+  const explicit = (env.POSTHOG_APP_HOST ?? "").trim().replace(/\/+$/, "");
+  if (explicit) return /^https:\/\/[a-z0-9.-]+$/i.test(explicit) ? { host: explicit } : { missing: "POSTHOG_APP_HOST (must look like https://us.posthog.com)" };
+  const ingest = (env.VITE_PUBLIC_POSTHOG_HOST ?? "").trim();
+  if (!ingest) return { host: "https://us.posthog.com" };
+  try {
+    const h = new URL(ingest).hostname;
+    if (h.endsWith(".i.posthog.com")) return { host: `https://${h.replace(".i.posthog.com", ".posthog.com")}` };
+    if (h === "us.posthog.com" || h === "eu.posthog.com" || h === "app.posthog.com") return { host: `https://${h}` };
+  } catch {
+    // fall through to asking for it explicitly
+  }
+  return { missing: "POSTHOG_APP_HOST" };
+}
+
+// Only PostHog's own embed pages may be framed inside the admin, so a typo can't put an arbitrary site there.
+const EMBED_URL = /^https:\/\/(us|eu|app)\.posthog\.com\/embedded\/[A-Za-z0-9_-]+(\?[A-Za-z0-9_=&.%-]*)?$/;
+
+export function resolveConfig(env: HogEnv): { ok: true; config: HogConfig } | { ok: false; missing: string[] } {
+  const missing: string[] = [];
+  const key = (env.POSTHOG_PERSONAL_API_KEY ?? "").trim();
+  if (!key) missing.push("POSTHOG_PERSONAL_API_KEY");
+  const projectId = (env.POSTHOG_PROJECT_ID ?? "").trim();
+  if (!/^\d{1,12}$/.test(projectId)) missing.push("POSTHOG_PROJECT_ID");
+  const host = deriveAppHost(env);
+  if ("missing" in host) missing.push(host.missing);
+  if (missing.length > 0 || "missing" in host) return { ok: false, missing };
+  const embed = (env.POSTHOG_EMBED_URL ?? "").trim();
+  return { ok: true, config: { key, projectId, appHost: host.host, embedUrl: EMBED_URL.test(embed) ? embed : null } };
+}
+
+const since = (days: Days) => `timestamp >= now() - INTERVAL ${days} DAY`;
+const eventList = TRACKED_EVENTS.map((e) => `'${e}'`).join(", ");
+
+/** One independent query per card, so one failing never blanks the whole page. */
+export function buildQueries(days: Days) {
+  return {
+    totals: `SELECT count(DISTINCT distinct_id) AS visitors, count() AS pageviews FROM events WHERE event = '$pageview' AND ${since(days)}`,
+    daily: `SELECT toString(toDate(timestamp)) AS day, count() AS pageviews, count(DISTINCT distinct_id) AS visitors FROM events WHERE event = '$pageview' AND ${since(days)} GROUP BY day ORDER BY day`,
+    events: `SELECT event, count(DISTINCT distinct_id) AS people, count() AS total, sum(toFloat(properties.price)) AS value FROM events WHERE event IN (${eventList}) AND ${since(days)} GROUP BY event`,
+    pages: `SELECT properties.$pathname AS path, count() AS views FROM events WHERE event = '$pageview' AND ${since(days)} GROUP BY path ORDER BY views DESC LIMIT 10`,
+    sources: `SELECT if(properties.$referring_domain IS NULL OR properties.$referring_domain IN ('', '$direct'), 'Direct', properties.$referring_domain) AS source, count(DISTINCT distinct_id) AS visitors FROM events WHERE event = '$pageview' AND ${since(days)} GROUP BY source ORDER BY visitors DESC LIMIT 8`,
+    devices: `SELECT ifNull(properties.$device_type, 'Unknown') AS device, count(DISTINCT distinct_id) AS visitors FROM events WHERE event = '$pageview' AND ${since(days)} GROUP BY device ORDER BY visitors DESC`,
+    errors: `SELECT count() AS errors FROM events WHERE event = '$exception' AND ${since(days)}`,
+  } as const;
+}
+export type QueryName = keyof ReturnType<typeof buildQueries>;
+export const QUERY_COUNT = Object.keys(buildQueries(7)).length;
+
+type Fetch = typeof fetch;
+
+/** Run one HogQL query. Throws a short, admin-readable message on any failure. */
+export async function runHogQL(cfg: HogConfig, sql: string, name: string, fetchImpl: Fetch = fetch, timeoutMs = 20_000): Promise<unknown[][]> {
+  const ctrl = new AbortController();
+  const timer = setTimeout(() => ctrl.abort(), timeoutMs);
+  try {
+    const res = await fetchImpl(`${cfg.appHost}/api/projects/${cfg.projectId}/query/`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json", Authorization: `Bearer ${cfg.key}` },
+      body: JSON.stringify({ query: { kind: "HogQLQuery", query: sql, name: `edurack-admin-${name}` } }),
+      signal: ctrl.signal,
+    });
+    if (!res.ok) {
+      if (res.status === 401 || res.status === 403) throw new Error("PostHog refused the key. Check it is a personal API key with the Query: Read scope, and that the project ID is right.");
+      if (res.status === 404) throw new Error("PostHog couldn't find that project. Check POSTHOG_PROJECT_ID and the region (US/EU).");
+      if (res.status === 429) throw new Error("PostHog is rate-limiting requests. Wait a few minutes and refresh.");
+      const body = (await res.json().catch(() => null)) as { detail?: string } | null;
+      throw new Error(`PostHog error ${res.status}${body?.detail ? `: ${String(body.detail).slice(0, 160)}` : ""}`);
+    }
+    const json = (await res.json()) as { results?: unknown[][] };
+    return Array.isArray(json.results) ? json.results : [];
+  } catch (e) {
+    if ((e as Error).name === "AbortError") throw new Error("PostHog took too long to answer.");
+    throw e;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+const num = (v: unknown) => {
+  const n = Number(v);
+  return Number.isFinite(n) ? n : 0;
+};
+
+export type PostHogSnapshot = {
+  configured: true;
+  fetchedAt: string;
+  days: Days;
+  appUrl: string;
+  embedUrl: string | null;
+  totals: { visitors: number; pageviews: number } | null;
+  daily: { day: string; pageviews: number; visitors: number }[] | null;
+  events: Record<string, { people: number; total: number; value: number }> | null;
+  topPages: { path: string; views: number }[] | null;
+  sources: { source: string; visitors: number }[] | null;
+  devices: { device: string; visitors: number }[] | null;
+  errors: number | null;
+  /** Cards that couldn't load, with a plain reason. Everything else still renders. */
+  failures: { card: QueryName; message: string }[];
+};
+export type PostHogNotConfigured = { configured: false; missing: string[] };
+
+/** Fill days with no traffic so the chart has a bar (an empty one) for every day. */
+function fillDays(rows: { day: string; pageviews: number; visitors: number }[], days: Days) {
+  const byDay = new Map(rows.map((r) => [r.day, r]));
+  const last = rows.length ? rows[rows.length - 1].day : new Date().toISOString().slice(0, 10);
+  const out: typeof rows = [];
+  const end = new Date(`${last}T00:00:00Z`).getTime();
+  for (let i = days - 1; i >= 0; i--) {
+    const day = new Date(end - i * 86_400_000).toISOString().slice(0, 10);
+    out.push(byDay.get(day) ?? { day, pageviews: 0, visitors: 0 });
+  }
+  return out;
+}
+
+export async function buildSnapshot(cfg: HogConfig, days: Days, fetchImpl: Fetch = fetch): Promise<PostHogSnapshot> {
+  const queries = buildQueries(days);
+  const names = Object.keys(queries) as QueryName[];
+  const settled = await Promise.allSettled(names.map((n) => runHogQL(cfg, queries[n], n, fetchImpl)));
+  const rows = {} as Record<QueryName, unknown[][]>;
+  const failures: PostHogSnapshot["failures"] = [];
+  settled.forEach((r, i) => {
+    if (r.status === "fulfilled") rows[names[i]] = r.value;
+    else failures.push({ card: names[i], message: r.reason instanceof Error ? r.reason.message : "Unknown error" });
+  });
+
+  const ok = (n: QueryName) => rows[n] !== undefined;
+  return {
+    configured: true,
+    fetchedAt: new Date().toISOString(),
+    days,
+    appUrl: `${cfg.appHost}/project/${cfg.projectId}`,
+    embedUrl: cfg.embedUrl,
+    totals: ok("totals") ? { visitors: num(rows.totals[0]?.[0]), pageviews: num(rows.totals[0]?.[1]) } : null,
+    daily: ok("daily") ? fillDays(rows.daily.map((r) => ({ day: String(r[0]), pageviews: num(r[1]), visitors: num(r[2]) })), days) : null,
+    events: ok("events") ? Object.fromEntries(rows.events.map((r) => [String(r[0]), { people: num(r[1]), total: num(r[2]), value: num(r[3]) }])) : null,
+    topPages: ok("pages") ? rows.pages.filter((r) => r[0]).map((r) => ({ path: String(r[0]), views: num(r[1]) })) : null,
+    sources: ok("sources") ? rows.sources.map((r) => ({ source: String(r[0]), visitors: num(r[1]) })) : null,
+    devices: ok("devices") ? rows.devices.map((r) => ({ device: String(r[0]), visitors: num(r[1]) })) : null,
+    errors: ok("errors") ? num(rows.errors[0]?.[0]) : null,
+    failures,
+  };
+}
