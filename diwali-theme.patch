+// Diwali typography: Instrument Serif (a tall, elegant editorial serif; italic for "Diwali") paired with Bricolage
+// Grotesque 800 (already used by the site) for the giant numerals. Self-hosted via Fontsource like the rest of the
+// site; the browser only downloads a face when text actually uses it, so once the sale ends nothing is fetched.
+//
+// Requires (run once):  npm install @fontsource/instrument-serif
+import "@fontsource/instrument-serif/400.css";
+import "@fontsource/instrument-serif/400-italic.css";
+import "@fontsource/bricolage-grotesque/800.css";
