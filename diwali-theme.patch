+/* Crisp four-point stars (dark surfaces only) */
+.dw-sparks { position: absolute; inset: 0; z-index: -10; overflow: hidden; pointer-events: none; }
+.dw-spark { position: absolute; display: block; opacity: 0; filter: drop-shadow(0 0 6px rgba(255, 200, 90, 0.9)); animation: dw-star 3.4s ease-in-out infinite; }
