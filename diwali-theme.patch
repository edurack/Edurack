+}
+.dw-btn-gold:hover { gap: 0.8rem; transform: translateY(-1px); box-shadow: 0 0 0 1px rgba(255, 240, 192, 0.7) inset, 0 14px 44px -8px rgba(255, 140, 30, 0.95), 0 0 40px -2px rgba(255, 181, 46, 0.65); }
+.dw-btn-gold:active { transform: scale(0.97); }
+.dw-btn-gold::after { /* light sweep */
+  content: ""; position: absolute; inset: 0 auto 0 0; width: 30%; pointer-events: none;
+  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
+  animation: promo-shine 3.4s ease-in-out infinite;
+}
+.dw-btn-ghost { color: #ffe3a0; border: 1px solid rgba(232, 176, 74, 0.5); }
+.dw-btn-ghost:hover { background: rgba(232, 176, 74, 0.12); border-color: #f2c45f; }
+.dw-btn-gold:focus-visible, .dw-btn-ghost:focus-visible { outline: 2px solid #ffd978; outline-offset: 3px; }
+
+/* Gold marquee tape */
+.dw-tape {
+  position: relative; z-index: 2; overflow: hidden; color: #2a1206;
+  background: linear-gradient(100deg, #fff0c0, #f2c45f 30%, #e8a23a 60%, #f6d77c);
