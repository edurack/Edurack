+}
+.dw-glass:hover { border-color: rgba(255, 214, 140, 0.5); }
+.dw-icon { color: #2a1206; background: linear-gradient(135deg, #fff0c0, #e8a23a); box-shadow: 0 0 22px -2px rgba(255, 170, 50, 0.7); }
+
+.dw-tile-box {
+  border-radius: 0.9rem;
+  border: 1px solid rgba(232, 176, 74, 0.32);
