+  border-bottom: 1px solid rgba(232, 176, 74, 0.45);
+  box-shadow: 0 6px 28px -10px rgba(255, 122, 24, 0.55);
+}
+
+/* ── Fixed ambient overlays (all pointer-events:none) ─────────────── */
+.dw-garland { position: fixed; inset: 0 0 auto 0; height: 22px; overflow: hidden; z-index: 60; pointer-events: none; }
+.dw-garland-row { display: flex; width: max-content; }
+.dw-tile {
+  position: relative; flex: none; width: 100px; height: 22px;
+  background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='22' viewBox='0 0 100 22'><path d='M0 1Q50 15 100 1' fill='none' stroke='%23b8862b' stroke-width='1.1' stroke-linecap='round'/></svg>") repeat-x;
+}
+.dw-bulb {
+  position: absolute; width: 5px; height: 8px; margin-left: -2.5px;
+  border-radius: 50% 50% 50% 50% / 38% 38% 62% 62%;
+  background: radial-gradient(circle at 38% 28%, #fff 0 12%, var(--c) 58%);
+  box-shadow: 0 0 6px 1px color-mix(in srgb, var(--c) 80%, transparent), 0 0 16px 4px color-mix(in srgb, var(--c) 40%, transparent);
+  animation: dw-twinkle 2.6s ease-in-out infinite;
+  animation-delay: var(--d);
+}
+.dw-bulb::before { content: ""; position: absolute; left: 50%; top: -2px; width: 3px; height: 3px; margin-left: -1.5px; border-radius: 1px; background: #8d5f1a; }
+@keyframes dw-twinkle { 0%, 100% { opacity: 1; filter: brightness(1.15); } 50% { opacity: 0.55; filter: brightness(0.8); } }
+
+.dw-glow {
+  position: fixed; inset: 0; z-index: 44; pointer-events: none;
+  background:
+    radial-gradient(38rem 22rem at 0% 0%, rgba(255, 140, 30, 0.11), transparent 70%),
+    radial-gradient(38rem 22rem at 100% 0%, rgba(255, 181, 46, 0.11), transparent 70%);
+  animation: dw-breathe 6s ease-in-out infinite;
+}
+@keyframes dw-breathe { 50% { opacity: 0.6; } }
+
+.dw-corner-diya { position: fixed; bottom: 6px; z-index: 44; width: 52px; height: 42px; pointer-events: none; display: none; }
+@media (min-width: 1024px) { .dw-corner-diya { display: block; } }
+.dw-flame { transform-origin: 40px 28px; animation: dw-flicker 1.9s ease-in-out infinite; }
+.dw-flame-halo { animation: dw-halo 2.4s ease-in-out infinite; transform-origin: 40px 24px; }
+@keyframes dw-flicker { 0%, 100% { transform: scale(1, 1) rotate(-1.5deg); } 30% { transform: scale(0.94, 1.08) rotate(2deg); } 60% { transform: scale(1.04, 0.95) rotate(-2deg); } }
+@keyframes dw-halo { 50% { transform: scale(1.18); opacity: 0.4; } }
+
+@media (max-width: 639px) {
+  .dw-garland-row { transform: scale(0.8); transform-origin: 0 0; }
+}
+
+/* ── Warm touches on the EXISTING design (only while data-diwali is on) ──
+   Same layout, same colours for text and surfaces; just a gilded edge, a soft marigold glow and gold selection. */
+html[data-diwali="on"] ::selection { background: #ffd978; color: #2a1206; }
+
+html[data-diwali="on"] header.sticky { box-shadow: 0 10px 30px -20px rgba(255, 140, 30, 0.55); }
+html[data-diwali="on"] header.sticky::after {
+  content: ""; position: absolute; inset-inline: 0; bottom: -1px; height: 1px; pointer-events: none;
+  background: linear-gradient(90deg, transparent, rgba(232, 176, 74, 0.9) 20%, rgba(255, 240, 192, 0.95) 50%, rgba(232, 176, 74, 0.9) 80%, transparent);
+}
+
+/* the site's dark "ink" bands pick up an ember glow and a gold hairline */
+html[data-diwali="on"] .ink-section,
+html[data-diwali="on"] .bg-\[\#141b2b\] {
+  background-image:
+    radial-gradient(55% 90% at 100% 0%, rgba(255, 140, 30, 0.2), transparent 65%),
+    radial-gradient(45% 80% at 0% 100%, rgba(232, 176, 74, 0.14), transparent 65%);
+  box-shadow: inset 0 1px 0 rgba(232, 176, 74, 0.45), inset 0 -1px 0 rgba(232, 176, 74, 0.25);
+}
+
+/* primary buttons keep their blue; they just glow like they're lit by a diya on hover */
+html[data-diwali="on"] a.bg-primary:hover,
+html[data-diwali="on"] button.bg-primary:hover {
+  box-shadow: 0 0 0 3px rgba(255, 181, 46, 0.28), 0 10px 28px -8px rgba(255, 140, 30, 0.6);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .dw-glow, .dw-sparks { display: none; }
+  .dw-bulb, .dw-gold-text, .dw-flame, .dw-flame-halo, .dw-kicker-dot, .dw-tape-track,
+  .dw-btn-gold::after, .dw-overlay, .dw-popup { animation: none !important; }
+}
