+// src/lib/jee-blueprint-data.ts
+//
+// Raw data for the public JEE Main chapter-wise weightage pages.
+//
+// Source: Careers360, "JEE Main Last Five-Year Analysis (2022-2026)". Counts are the number of
+// questions asked from each chapter / concept across ALL shifts and sessions of that year's
+// papers (so a year's Physics total is well above one paper's 25 questions).
+//
+// How this was cleaned (the eBook's tables were extracted from a PDF and are noisy):
+//   - Chapter rows: every per-year cell was kept and ALL totals, shares and averages are computed
+//     from those cells. The eBook's printed "Grand Total", "Percentage" and "Average" tables do not
+//     add up to its own rows for Chemistry and Maths, so they are deliberately not used.
+//   - Physics also had a 2021 column; it is dropped so all three subjects cover 2022-2026.
+//   - Concept rows: kept only when the per-year cells add up to the printed total (+/- 1).
+//     Rows that did not reconcile are in JEE_CONCEPTS_TO_VERIFY and are NOT shown on the site.
+//     Check them against the PDF and move them into JEE_RAW.concepts once confirmed.
+//   - "Stoichiometry and Limiting Reagent" was clipped in the PDF; its 2025/2026 cells were
+//     reconstructed so the row adds up to the printed total of 26.
+//   - Parent chapters of concepts are an editorial mapping (not in the eBook); omitted when ambiguous.
+//   - `retired` = not part of the JEE Main 2026 syllabus published by NTA.
+
+export const JEE_YEARS = ["2022", "2023", "2024", "2025", "2026"] as const;
+
+export type JeeRawChapter = { slug: string; name: string; years: number[]; retired: boolean; syllabus: string };
+export type JeeRawConcept = { name: string; years: number[]; chapter?: string };
+export type JeeRawSubject = { key: string; name: string; short: string; chapters: JeeRawChapter[] };
+
+export const JEE_RAW: {
+  subjects: JeeRawSubject[];
+  concepts: Record<string, JeeRawConcept[]>;
+} = {"subjects": [{"key": "physics", "name": "Physics", "short": "Physics", "chapters": [{"slug": "atoms-and-nuclei", "name": "Atoms and Nuclei", "years": [31, 46, 39, 23, 24], "retired": false, "syllabus": "Alpha-particle scattering, Rutherford and Bohr models, energy levels, hydrogen spectrum, nuclear composition and size, mass-energy relation, mass defect, binding energy, fission and fusion."}, {"slug": "communication-systems", "name": "Communication Systems", "years": [20, 21, 0, 0, 0], "retired": true, "syllabus": ""}, {"slug": "current-electricity", "name": "Current Electricity", "years": [44, 52, 50, 22, 24], "retired": false, "syllabus": "Drift velocity, Ohm's law, resistivity, series and parallel combinations, temperature dependence of resistance, cells with internal resistance, Kirchhoff's laws, Wheatstone bridge, metre bridge."}, {"slug": "dual-nature-of-matter-and-radiation", "name": "Dual Nature of Matter and Radiation", "years": [21, 27, 25, 19, 16], "retired": false, "syllabus": "Photoelectric effect, Hertz and Lenard's observations, Einstein's photoelectric equation, particle nature of light, matter waves and the de Broglie relation."}, {"slug": "electromagnetic-induction-and-alternating-currents", "name": "Electromagnetic Induction and Alternating Currents", "years": [41, 48, 45, 18, 25], "retired": false, "syllabus": "Faraday's and Lenz's laws, induced emf, eddy currents, self and mutual inductance, AC, RMS values, reactance and impedance, series LCR circuit, resonance, power in AC circuits, AC generator and transformer."}, {"slug": "electromagnetic-waves", "name": "Electromagnetic Waves", "years": [21, 25, 15, 7, 17], "retired": false, "syllabus": "Displacement current, characteristics and transverse nature of electromagnetic waves, the electromagnetic spectrum and its applications."}, {"slug": "electronic-devices", "name": "Electronic Devices", "years": [26, 25, 19, 18, 20], "retired": false, "syllabus": "Semiconductors, p-n junction diode chara