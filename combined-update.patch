+    ${unsubscribeFooter(params.unsubscribeUrl, "because you're an Edurack Pro student")}
+  `;
+  return emailLayout({ previewText: "NCERT Line by Line will be completely free for Pro students. No extra payment.", bodyHtml: body });
+}
